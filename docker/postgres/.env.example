# Template for .env (which git ignores). Copy it and change the passwords:
#   cp .env.example .env
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=15.19
POSTGRES_HOST_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_DB=sakila
POSTGRES_VOLUME_PATH=/data/postgres
POSTGRES_INIT_SQL=docker_postgres_init.sql
POSTGRES_HOST_PORT=15432
POSTGRES_CONTAINER_PORT=5432

PGADMIN_IMAGE=dpage/pgadmin4
PGADMIN_VERSION=9.17
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme_local_dev
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False
PGADMIN_VOLUME_PATH=/data/pgadmin
PGADMIN_SERVER_CONFIG=docker_pgadmin_servers.json
PGADMIN_HOST_PORT=15433
PGADMIN_CONTAINER_PORT=80
