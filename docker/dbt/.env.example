# Template for .env (which git ignores). Copy it with:
#   cp .env.example .env
#
# dbt stack settings, read two ways:
#   1. docker compose loads this file for the ${VAR} values in docker-compose.yml.
#   2. The Makefile includes it, so "make dbt-docs-serve" uses the same port.
#
# Postgres credentials are not repeated here: docker-compose.yml reads them
# from ../postgres/.env.

DBT_CONTAINER_NAME=app_dbt
DBT_HOSTNAME=dbt

# Port for the dbt docs site, the same inside and outside the container.
DBT_DOCS_PORT=8080
